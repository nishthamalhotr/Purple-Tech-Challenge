FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 \
    ffmpeg libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Install pipeline requirements (includes ultralytics, OpenCV)
COPY requirements.txt .
COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements-pipeline.txt

COPY pipeline/ ./pipeline/
COPY configs/ ./configs/

RUN useradd --create-home appuser && chown -R appuser /app
USER appuser

# Store output volume
VOLUME ["/data"]

CMD ["python", "-m", "pipeline.run_pipeline", "--config", "/app/configs/store_layout.json"]
